# Epicure Assist — minimal env template (see README for staging vs prod).
# Copy to `.env.local`. Use `KEY=value` only (not `KEY:`). Omit optional keys or leave unset.
# Load order (later wins): `.env.production` → `.env.development.local` → `.env.local`

# --- Epicure ---
EPICURE_DEPLOYMENT=local
# EPICURE_PRIMARY_SUPPORT_EMAIL=connect@epicurerobotics.com

# --- AI (required) ---
# OPENAI_API_KEY=

# --- Optional: Redis (Upstash) — faster cache for chat, embeddings, sample questions ---
# REDIS_URL=rediss://default:YOUR_PASSWORD@YOUR_HOST.upstash.io:6379

# --- Supabase (required for hosted DB) ---
# NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# AUTH_URL=https://your-app.example
# Optional: if pg_cron cannot reach AUTH_URL (rare). Local Docker DB + app on host uses host.docker.internal:3010 when POSTGRES_URL is localhost.
# JOB_WORKER_URL=https://your-app.example

# --- Postgres: pooler + direct, same project (Supabase → Database) ---
# POSTGRES_URL=postgresql://...
# POSTGRES_URL_NON_POOLING=postgresql://...
# LOCAL_SUPABASE_DB_PORT=54322

# --- Gmail + Pub/Sub (ingestion) ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_PUBSUB_TOPIC_NAME=
# GOOGLE_PUBSUB_CLAIM_EMAIL=

# --- Seed / admin (comma-separated) ---
# INITIAL_USER_EMAILS=epicure-seed@example.com

# --- Optional / not used by default Epicure flow ---
# DATABASE_URL=          # drizzle alias; empty unsets
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=          # Gmail address
# SMTP_PASSWORD=      # Gmail App Password (https://myaccount.google.com/apppasswords)
# SMTP_FROM_ADDRESS=  # From address, typically same as SMTP_USER
# NEXT_PUBLIC_SENTRY_DSN=
# DRIZZLE_LOGGING=true

# --- Web Push (Settings → Notifications → Browser Push) ---
# Without all three the toggle renders but no push is ever delivered.
# Generate a pair with: npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_MAILTO=          # contact address for push services, e.g. software@epicurerobotics.com
